NODE_ENV=production

# Coolify service domains.
# Example:
# CORS_ALLOWED_ORIGINS=https://admin.example.com
# VITE_API_BASE_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com
VITE_API_BASE_URL=https://api.example.com
VITE_SOCKET_PATH=/socket.io

# Supabase PostgreSQL.
# Preferred: paste the Supabase Session pooler URI or direct PostgreSQL URI.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SEARCH_PATH=public,extensions

# Alternative if you do not use DATABASE_URL:
# DB_HOST=aws-0-region.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.project-ref
# DB_PASSWORD=change-this-supabase-password

# Backend security.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_REMEMBER_ME_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_VERIFICATION_TTL_SECONDS=86400
APP_PUBLIC_URL=https://app.gottaxi.co
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=contacto@gottaxi.co
MAIL_PASSWORD=change-this-hostinger-mailbox-password
MAIL_FROM="GotTaxi <contacto@gottaxi.co>"

# Optional runtime settings.
HTTP_TRUST_PROXY=1
LOG_LEVEL=info
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
