{
  "name": "taxipostgres",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "deploy:check": "npm test",
    "test": "node --test",
    "simulate": "node simulator/simulator.js",
    "simulate:race": "DRIVER_COUNT=2 CUSTOMER_COUNT=1 node simulator/backendRaceTest.js",
    "simulate:retries": "DRIVER_COUNT=1 CUSTOMER_COUNT=1 node simulator/backendRetryTest.js",
    "simulate:matching": "DRIVER_COUNT=5 CUSTOMER_COUNT=1 node simulator/backendMatchingTest.js",
    "simulate:drivers": "DRIVER_COUNT=100 CUSTOMER_COUNT=0 node simulator/simulator.js",
    "simulate:customers": "DRIVER_COUNT=0 CUSTOMER_COUNT=500 node simulator/simulator.js",
    "simulate:chaos": "ENABLE_CHAOS_MODE=true node simulator/simulator.js",
    "simulate:cleanup": "node scripts/simulate-cleanup.js",
    "admin:create": "node scripts/create-admin-user.js",
    "migrate:make": "npx knex migrate:make",
    "migrate:latest": "npx knex migrate:latest",
    "migrate:rollback": "npx knex migrate:rollback",
    "seed:run": "npx knex seed:run",
    "seed:make": "npx knex seed:make"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "knex": "^3.1.0",
    "libphonenumber-js": "^1.13.8",
    "pg": "^8.16.3",
    "rate-limit-redis": "^6.0.0",
    "redis": "^6.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}
