# Firebase Cloud Messaging - backend only (never VITE_*).
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=gottaxi-191c2
# Recommended on Coolify: absolute path INSIDE the container to a read-only secret mount.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gottaxi-firebase-admin.json
# Alternative: omit GOOGLE_APPLICATION_CREDENTIALS and set FIREBASE_SERVICE_ACCOUNT_JSON
# to the complete single-line service-account JSON as a secret. Do not set both.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"gottaxi-191c2","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
PUSH_WORKER_INTERVAL_MS=500
PUSH_INVITATION_ACK_WAIT_MS=2000
PUSH_VISIBILITY_TTL_SECONDS=40
PUSH_BATCH_SIZE=50
PUSH_MAX_ATTEMPTS=3
PUSH_INVITE_TTL_SECONDS=60
PUSH_RETENTION_DAYS=30
